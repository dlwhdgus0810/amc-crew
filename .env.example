# ── Upstash Redis (필수: Vercel 배포 시) ─────────────────────────────
# Vercel 대시보드 → Storage → Upstash Redis 연결 시 자동으로 주입됩니다.
# 로컬 개발 시 비워두면 메모리 저장소로 동작합니다 (서버 재시작 시 초기화).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 관리자 키 (필수) ─────────────────────────────────────────────────
# /admin 페이지에서 스케줄을 수정할 때 사용하는 비밀 키. 아무 문자열이나 설정하세요.
ADMIN_KEY=change-me

# ── AMC 공식 API (선택) ──────────────────────────────────────────────
# https://developers.amctheatres.com 에서 Vendor Key를 발급받아 넣으면
# 관리자 페이지의 "AMC에서 새로고침" 버튼으로 실시간 스케줄을 가져옵니다.
AMC_VENDOR_KEY=

# AMC 극장 ID (AMC Town Center 20). Vendor Key 발급 후
# GET https://api.amctheatres.com/v2/theatres?name=town-center 로 확인하세요.
AMC_THEATRE_ID=

# ── AMC 샌드박스 테스트 (선택) ───────────────────────────────────────
# 샌드박스 키로 연동을 먼저 테스트하려면 아래처럼 설정하세요.
# 샌드박스는 테스트 극장 5곳의 시뮬레이션 데이터라서 실제 스케줄은 안 나옵니다.
# AMC_API_BASE=https://api.sandbox-amctheatres.com/v2
# AMC_MOVIE_MATCH=.*   # 샌드박스에 The Odyssey가 없으면 모든 영화로 테스트
